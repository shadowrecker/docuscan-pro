<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>DocuScan Pro</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>DocuScan Pro</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- Camera permission -->
	<key>NSCameraUsageDescription</key>
	<string>DocuScan Pro needs camera access to scan documents, whiteboards, and QR codes.</string>

	<!-- Photo library permission -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>DocuScan Pro needs photo library access to import images for conversion and editing.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>DocuScan Pro needs to save scanned documents and exports to your photo library.</string>

	<!-- Microphone (needed by camera plugin even if unused) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>This app does not record audio.</string>

	<!-- Google AdMob App ID (Test ID - replace before release) -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>

	<!-- SKAdNetwork for AdMob -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>

	<!-- Document types the app can open -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF Document</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>

	<!-- Google Sign-In (google_sign_in 7.x). Replace with the iOS OAuth
	     client ID and its reversed form from GoogleService-Info.plist /
	     Google Cloud console (must match AppConstants.googleIosClientId). -->
	<key>GIDClientID</key>
	<string>REPLACE_WITH_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com</string>

	<!-- URL schemes: Google Sign-In callback (reversed client ID) and the
	     Dropbox OAuth redirect db-<DROPBOX_APP_KEY> (must match
	     AppConstants.dropboxRedirectScheme). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.REPLACE_WITH_GOOGLE_IOS_CLIENT_ID</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>db-REPLACE_WITH_DROPBOX_APP_KEY</string>
			</array>
		</dict>
	</array>

	<!-- url_launcher canOpenURL checks for scanned QR links / Dropbox app -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
		<string>dbapi-2</string>
		<string>dbapi-8-emm</string>
	</array>

	<key>UISupportsDocumentBrowser</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
